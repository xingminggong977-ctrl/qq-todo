# 复制成 .env 后按需修改：cp .env.example .env
# 全部键都有默认值，.env 不存在也能启动（等价于下面这份「最小离线配置」）。

# ===== 服务 =====
# 监听端口与地址。0.0.0.0 才能让手机在局域网里连上；只想本机用就写 127.0.0.1
PORT=7788
HOST=0.0.0.0
# 数据目录，store.json 与附件都落在这里（不要放进版本库）
DATA_DIR=./data

# 手机扫码用的公网/局域网地址，例如 https://todo.example.com 或 http://192.168.1.10
# 留空则启动时自动取本机局域网 IPv4
PUBLIC_URL=

# 访问令牌。**留空 = 不鉴权**，只适合本机开发；部署到公网前务必填一个长随机串。
# 非空时所有页面与接口都要带 ?t=<token>（或 qqtd Cookie），启动打印的二维码会自动带上。
AUTH_TOKEN=

# ===== HTTPS（可选）=====
# 对外直接提供 HTTPS 时填这里；0 表示不监听
HTTPS_PORT=0
TLS_CERT=
TLS_KEY=
# 80 口只做「跳到 https」，0 = 不监听。需要 HTTPS_PORT 同时开启
REDIRECT_PORT=0

# ===== LLM 抽取（可选）=====
# stub = 纯本地规则引擎，不联网、零成本、结果可复现（默认）
# openai = 任何 OpenAI 兼容的 /chat/completions 服务
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=90000
# 计价单价（美元 / 百万 token），只用于统计页的成本估算
LLM_PRICE_IN=0.14
LLM_PRICE_OUT=0.28

# ===== 实时订阅（NapCat / OneBot 11，可选）=====
# on = 启动只读 WS 订阅器；off = 只用导入
LIVE_ENABLED=off
NAPCAT_WS_URL=ws://127.0.0.1:3001/
NAPCAT_ACCESS_TOKEN=
# 逗号分隔的**群名**白名单；留空 = 收全部群
GROUP_ALLOWLIST=
# 允许私聊转发通道的 QQ 号（只填你自己的号）
OWNER_QQ=
# 私聊消息在界面上的别名，留空则显示 QQ 号
PRIVATE_ALIAS=

# 轮询兜底：WS 掉线时按固定间隔拉历史消息
LIVE_POLL_ENABLED=off
LIVE_POLL_INTERVAL_SEC=300
LIVE_POLL_MAX_PER_GROUP=50

# ===== 图片消息视觉识别（可选）=====
# 用 LLM_BASE_URL / LLM_API_KEY 指向的同一个多模态端点
VISION_ENABLED=on
VISION_MODEL=qwen3-vl-plus
# 单次抽取最多处理几张图（控成本）
VISION_MAX_PER_RUN=8
VISION_TIMEOUT_MS=30000

# ===== Web Push（可选）=====
# 用 npx web-push generate-vapid-keys 生成一对，私钥不要进版本库
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== 只读在线演示站 =====
# on：/demo/ 免口令只读浏览（数据在 <DATA_DIR>/demo，独立于真实库）；off：/demo 直接 404
DEMO_ENABLED=on
